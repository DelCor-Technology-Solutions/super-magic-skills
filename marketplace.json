mkdir -p .claude-plugin
cat > .claude-plugin/marketplace.json <<'EOF'
{
  "name": "delcor-skills",
  "owner": { "name": "DelCor Technology Solutions" },
  "plugins": [
    {
      "name": "delcor-imported",
      "source": "./",
